{
  "name": "@lobbystack/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lobbystack/agent-core": "workspace:*",
    "@lobbystack/contracts": "workspace:*",
    "@lobbystack/db": "workspace:*",
    "@lobbystack/domain": "workspace:*",
    "@lobbystack/jobs": "workspace:*",
    "@lobbystack/providers": "workspace:*",
    "@lobbystack/shared": "workspace:*",
    "@lobbystack/telemetry": "workspace:*",
    "bullmq": "6.7.7",
    "drizzle-orm": "latest",
    "ioredis": "latest",
    "mammoth": "latest",
    "openai": "7.59.0",
    "pdf-parse": "latest",
    "tesseract.js": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "posthog-node": "6.0.2",
    "tsup": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
