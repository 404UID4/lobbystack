{
  "name": "@lobbystack/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 next build && pnpm run marketing:postbuild",
    "marketing:postbuild": "node scripts/marketing/postbuild.mjs",
    "marketing:validate": "node scripts/marketing/validate-seo.mjs",
    "start": "next start",
    "pretypecheck": "pnpm --filter @lobbystack/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:parity": "playwright test --config playwright.parity.config.ts",
    "e2e:parity:certify": "node ../../scripts/admin-ui-visual-certify.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "latest",
