{
  "name": "@lobbystack/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:check": "tsx src/cli.ts check",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset:test": "tsx src/cli.ts reset-test",
    "db:verify-rls": "tsx src/cli.ts verify-rls",
    "db:backfill-agent-links": "tsx src/cli.ts backfill-agent-links"
  },
  "dependencies": {
    "@lobbystack/contracts": "workspace:*",
    "@lobbystack/telemetry": "workspace:*",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "pg": "latest",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "vitest": "latest"
  }
}
