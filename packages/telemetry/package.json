{
  "name": "@lobbystack/telemetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opentelemetry/api": "latest",
    "@opentelemetry/exporter-logs-otlp-http": "latest",
    "@opentelemetry/exporter-metrics-otlp-http": "latest",
    "@opentelemetry/exporter-trace-otlp-http": "latest",
    "@opentelemetry/instrumentation-http": "latest",
    "@opentelemetry/instrumentation-undici": "latest",
    "@opentelemetry/resources": "latest",
    "@opentelemetry/sdk-metrics": "latest",
    "@opentelemetry/sdk-logs": "latest",
    "@opentelemetry/sdk-node": "latest",
    "@opentelemetry/sdk-trace": "latest",
    "posthog-node": "latest"
  },
  "devDependencies": {
    "vitest": "latest"
  }
}
