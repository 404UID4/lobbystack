{
  "name": "@lobbystack/providers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/providers/src/index.js",
  "types": "./dist/providers/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/src/index.d.ts",
      "import": "./dist/providers/src/index.js"
    },
    "./*": {
      "types": "./dist/providers/src/*.d.ts",
      "import": "./dist/providers/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "latest",
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@lobbystack/shared": "workspace:*",
    "@lobbystack/telemetry": "workspace:*",
    "ai": "latest",
    "libphonenumber-js": "latest",
    "luxon": "latest",
    "nodemailer": "latest",
    "standardwebhooks": "latest",
    "stripe": "latest",
    "twilio": "latest"
  },
  "devDependencies": {
    "@types/luxon": "latest",
    "@types/nodemailer": "latest"
  }
}
