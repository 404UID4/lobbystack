{
  "name": "@lobbystack/providers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/providers/src/index.js",
  "types": "./dist/providers/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/src/index.d.ts",
      "import": "./dist/providers/src/index.js"
    },
    "./*": {
      "types": "./dist/providers/src/*.d.ts",
      "import": "./dist/providers/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.93",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "@lobbystack/shared": "workspace:*",
    "@lobbystack/telemetry": "workspace:*",
    "ai": "7.0.176",
    "libphonenumber-js": "1.13.16",
    "luxon": "^3.7.2",
    "nodemailer": "10.6.0",
    "standardwebhooks": "^1.3.0",
    "stripe": "23.1.0",
    "twilio": "6.3.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^8.0.2"
  }
}
